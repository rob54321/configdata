#!/bin/bash
# script to build config.tar.xz after an update
# must be run in /home/robert/
cd /home/robert
tar --xz -C /home/robert -cvf config.tar.xz .bash_aliases .gitconfig .git-credentials .config/cinnamon .config/dconf .config/geany .config/gh .config/rclone .config/mate .config/ubuntu-mate .config/gtk-3.0 .config/libreoffice .local/share/cinnamon
